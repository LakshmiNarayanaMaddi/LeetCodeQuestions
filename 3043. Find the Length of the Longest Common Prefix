        Set<String> prefixes = new HashSet<>();

        // Store all prefixes of arr1 numbers
        for (int num : arr1) {
            String s = Integer.toString(num);
            for (int i = 1; i <= s.length(); i++) {
                prefixes.add(s.substring(0, i));
            }
        }

        int max = 0;

        // Check prefixes of arr2 numbers against the set
        for (int num : arr2) {
            String s = Integer.toString(num);
            for (int i = 1; i <= s.length(); i++) {
